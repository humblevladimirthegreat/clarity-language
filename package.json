{
  "name": "clarity-language",
  "version": "0.1.0",
  "description": "Agelan tooling — lexicon helpers and agent-facing docs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate:word": "peggy --format es --dts --allowed-start-rules start,words -o src/generated/word-parser.js grammar/word.peggy",
    "build": "npm run generate:word && tsc && mkdir -p dist/generated && cp src/generated/word-parser.js src/generated/word-parser.d.ts dist/generated/",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint:md": "node scripts/lint-md-balance.mjs",
    "docs:dev": "vitepress dev docs/grammar",
    "docs:build": "vitepress build docs/grammar && mkdir -p dist && cp scripts/docs-root-redirect.html dist/index.html",
    "docs:preview": "vitepress preview docs/grammar",
    "convert-word": "tsx scripts/convert-word.ts",
    "metaphor-assign": "tsx scripts/phase5-metaphor-assign.ts",
    "metaphor-assign-test": "tsx scripts/lib/metaphor-assign-data.test.ts && tsx scripts/lib/llm-client.test.ts",
    "lexicon-search": "tsx scripts/lexicon-search.ts",
    "unused-roots": "tsx scripts/unused-roots.ts",
    "build:lexicon-web": "esbuild src/lexicon-search.ts --bundle --format=esm --outfile=web/lib/lexicon-search.js --platform=browser",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts docs/grammar/.vitepress/components/*.test.ts",
    "parse": "tsx src/parse/cli.ts",
    "speak": "tsx src/tts/cli.ts",
    "web": "npm run build:lexicon-web && npx --yes serve . -p 4173 -o /web/"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "chevrotain": "^13.2.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@types/node": "^26.1.1",
    "esbuild": "^0.25.0",
    "happy-dom": "^20.11.1",
    "peggy": "^5.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4"
  }
}
