{
  "name": "clarity-language",
  "version": "0.1.0",
  "description": "Clarity Language tooling — ANTLR parsers and agent-facing APIs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "antlr-ng -Dlanguage=TypeScript -l false -o src/generated --exact-output-dir true grammar/SentenceParser.g4 grammar/WordParser.g4",
    "build": "npm run generate && tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint:md": "node scripts/lint-md-balance.mjs",
    "parse": "tsx src/cli.ts",
    "convert-word": "tsx scripts/convert-word.ts",
    "metaphor-assign": "tsx scripts/phase5-metaphor-assign.ts",
    "metaphor-assign-test": "tsx scripts/lib/metaphor-assign-data.test.ts && tsx scripts/lib/llm-client.test.ts",
    "lexicon-search": "tsx scripts/lexicon-search.ts",
    "build:lexicon-web": "esbuild src/lexicon-search.ts --bundle --format=esm --outfile=web/lib/lexicon-search.js --platform=browser",
    "test": "tsx --test src/**/*.test.ts",
    "web": "npm run build:lexicon-web && npx --yes serve . -p 4173 -o /web/"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "antlr4ng": "^3.0.16",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "@tiptap/core": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@types/node": "^26.1.1",
    "antlr-ng": "^1.0.10",
    "happy-dom": "^20.11.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
