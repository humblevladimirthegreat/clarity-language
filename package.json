{
  "name": "agazan",
  "version": "0.1.0",
  "description": "Agazan tooling — lexicon helpers and agent-facing docs",
  "type": "module",
  "scripts": {
    "generate:word": "peggy --format es --dts --allowed-start-rules start,words,probe_spanClose,probe_writingSpan,probe_freeNumber,probe_hook,probe_prefixedWord,probe_citation,probe_prefixedX,probe_prefixedPlain,probe_prefixedJoin -o src/generated/word-parser.js src/parse/word.peggy",
    "build": "node scripts/build.mjs",
    "dev": "vitepress dev docs/grammar",
    "typecheck": "tsc --noEmit",
    "lint:agazan": "tsx scripts/lint-agazan-docs.ts",
    "docs:publish": "vitepress build docs/grammar && tsx scripts/publish-docs-extras.mjs",
    "docs:preview": "vitepress preview docs/grammar",
    "convert-word": "tsx scripts/convert-word.ts",
    "retie-docs": "tsx scripts/retie-docs.ts",
    "regloss-docs": "tsx scripts/regloss-docs.ts",
    "metaphor-assign": "tsx scripts/phase5-metaphor-assign.ts",
    "metaphor-assign-test": "tsx scripts/lib/metaphor-assign-data.test.ts && tsx scripts/lib/llm-client.test.ts",
    "lexicon-search": "tsx scripts/lexicon-search.ts",
    "check-compounds": "tsx scripts/check-compound-uniqueness.ts",
    "lint:lexicon": "tsx scripts/lint-lexicon-published.ts",
    "unused-roots": "tsx scripts/unused-roots.ts",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts docs/grammar/.vitepress/components/*.test.ts docs/grammar/.vitepress/lib/*.test.ts scripts/lib/*.test.ts",
    "parse": "node scripts/parse.mjs",
    "find": "node scripts/find.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "SEE LICENSE IN NOTICE",
  "private": true,
  "dependencies": {
    "chevrotain": "^13.2.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.69.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.11.1",
    "peggy": "^5.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue-eslint-parser": "^10.4.1"
  }
}
