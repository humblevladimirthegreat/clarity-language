{
  "name": "ageben",
  "version": "0.1.0",
  "description": "Ageben tooling — lexicon helpers and agent-facing docs",
  "type": "module",
  "scripts": {
    "generate:word": "peggy --format es --dts --allowed-start-rules start,words,probe_writingSpan,probe_freeNumber,probe_hook,probe_prefixedWord,probe_citation,probe_prefixedX,probe_prefixedPlain,probe_prefixedJoin -o src/generated/word-parser.js src/parse/word.peggy",
    "build": "node scripts/build.mjs",
    "dev": "vitepress dev docs/grammar",
    "typecheck": "tsc --noEmit",
    "grammar-check": "tsx scripts/grammar-check.ts",
    "parse-snapshot": "tsx scripts/parse-snapshot.ts",
    "lint:ageben": "tsx scripts/lint-ageben-docs.ts",
    "lint:forward-links": "tsx scripts/lint-forward-links.ts",
    "free-english-review": "tsx scripts/free-english-review.ts",
    "llm-eval": "tsx scripts/llm-eval.ts",
    "docs:publish": "vitepress build docs/grammar && tsx scripts/publish-docs-extras.mjs",
    "docs:preview": "vitepress preview docs/grammar",
    "convert-word": "tsx scripts/convert-word.ts",
    "retie-docs": "tsx scripts/retie-docs.ts",
    "rename-language": "tsx scripts/rename-language.ts",
    "cheat-sheet-blocks": "tsx scripts/cheat-sheet-blocks.ts",
    "core-vocabulary": "tsx scripts/core-vocabulary.ts",
    "regloss-docs": "tsx scripts/regloss-docs.ts",
    "metaphor-assign": "tsx scripts/phase5-metaphor-assign.ts",
    "metaphor-assign-test": "tsx scripts/lib/metaphor-assign-data.test.ts && tsx scripts/lib/llm-client.test.ts",
    "lexicon-review": "tsx scripts/lexicon-review.ts",
    "lexicon-search": "tsx scripts/lexicon-search.ts",
    "check-compounds": "tsx scripts/check-compound-uniqueness.ts",
    "compound-fill": "tsx scripts/compound-fill.ts",
    "lint:lexicon": "tsx scripts/lint-lexicon-published.ts",
    "unused-roots": "tsx scripts/unused-roots.ts",
    "test": "node scripts/test.mjs",
    "parse": "node scripts/parse.mjs",
    "find": "node scripts/find.mjs",
    "find-english": "node scripts/find-english.mjs",
    "pegs": "node scripts/pegs.mjs",
    "english-helper": "node scripts/english-helper.mjs",
    "english-helper-recall": "tsx scripts/english-helper-recall.ts",
    "english-helper-eval": "tsx scripts/english-helper-eval.ts",
    "english-helper-wordnet": "tsx scripts/english-helper-wordnet.ts",
    "flashcards": "tsx scripts/flashcards.ts",
    "peel-band": "tsx scripts/peel-band.ts",
    "peel-headings": "tsx scripts/peel-headings.ts",
    "page-lines": "tsx scripts/page-lines.ts",
    "lint:cheat-sheet-print": "tsx scripts/lint-cheat-sheet-print.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "SEE LICENSE IN NOTICE",
  "private": true,
  "dependencies": {
    "chevrotain": "^13.2.0",
    "chevrotain-allstar": "^0.5.0",
    "compromise": "^14.18.0",
    "minisearch": "^7.2.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@tiptap/core": "^3.29.1",
    "@tiptap/markdown": "^3.29.1",
    "@tiptap/pm": "^3.29.1",
    "@tiptap/starter-kit": "^3.29.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.69.0",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.11.1",
    "pdfjs-dist": "^6.4.299",
    "peggy": "^5.1.0",
    "playwright": "^1.64.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue-eslint-parser": "^10.4.1"
  }
}
