# LM Studio (local model for metaphor-assign)
# From inside the devcontainer, LM Studio on the host is reached via host.docker.internal.
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# Model id from GET {LM_STUDIO_BASE_URL}/models (LangChain openai: prefix is stripped automatically)
LM_STUDIO_MODEL=qwen/qwen3.6-27b

# LM Studio does not validate the key; any non-empty value works.
OPENAI_API_KEY=lm-studio-local-key

# Optional: per-request timeout in ms (default 600000 = 10 minutes)
# LLM_REQUEST_TIMEOUT_MS=600000

# Legacy aliases (still supported):
# OPENAI_BASE_URL=http://host.docker.internal:1234/v1
# METAPHOR_ASSIGN_MODEL=qwen/qwen3.6-27b
